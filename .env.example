# FluxGK · variáveis da stack. No Portainer, isto vai no campo de environment
# variables de CADA stack (não suba este arquivo preenchido para o GitHub).
#
# ───────── stack fluxgk (produção, branch main) ─────────
#   PORTA_HTTP=3010        → proxy do Hestia em fluxgk.rstecbr.com.br
# ───────── stack fluxgk-hml (homologação, branch develop) ─────────
#   PORTA_HTTP=3011        → proxy do Hestia em hml.fluxgk.rstecbr.com.br
#
# As portas 3000 e 3001 NÃO servem: já são do manapp.

# Porta no loopback do host que o Hestia proxeia. Obrigatória.
PORTA_HTTP=3011

# Versão do binário oficial do PocketBase (GitHub releases).
PB_VERSION=0.40.5

# Superusuário do painel /_/ — é por ele que se reseta a senha de um usuário.
PB_ADMIN_EMAIL=admin@fluxgk.rstecbr.com.br
PB_ADMIN_PASSWORD=troque-esta-senha

# Cifragem do pb_data. Gere com: openssl rand -hex 16
PB_ENCRYPTION_KEY=

TZ=America/Bahia

# Ambiente que aparece em /versao.json e no rodapé do app: prd | hml.
AMBIENTE=hml

# Commit no ar. Não preencher: o CI manda ?GIT_COMMIT=<sha> no webhook do Portainer.
GIT_COMMIT=
